APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Self-Hosted SSO ---------------------------------------------------------
# The public URL of this Identity Provider. Must match the "iss" claim that
# relying parties validate, and the URL users are redirected to.
SSO_ISSUER="${APP_URL}"

# Self-registration is off by default; administrators create users instead.
# Both are set under Settings → App settings; uncomment to pin them here.
# SSO_ALLOW_REGISTRATION=false
# SSO_REQUIRE_EMAIL_VERIFICATION=true

# Require Proof Key for Code Exchange on the authorization code flow. Public
# clients always use PKCE regardless; this extends the requirement to
# confidential ones.
SSO_PKCE_REQUIRED=true

# Redirect URIs are always matched exactly; wildcards are never supported.
# Outside local development they must also use HTTPS, with a carve-out for
# loopback addresses so native and CLI clients can still be developed.
SSO_REQUIRE_HTTPS_REDIRECTS=true
SSO_ALLOW_INSECURE_LOOPBACK=true

# Token lifetimes, in seconds. Set under Settings → App settings; uncomment to
# pin them here.
# SSO_DEFAULT_ACCESS_TOKEN_TTL=900
# SSO_DEFAULT_REFRESH_TOKEN_TTL=1209600
# SSO_DEFAULT_ID_TOKEN_TTL=900

# Requests per minute for the protocol endpoints, keyed by client IP. The
# discovery limit also guards /oauth/authorize, which real users reach from
# browsers behind shared addresses.
SSO_RATE_LIMIT_DISCOVERY=120
SSO_RATE_LIMIT_TOKEN=30
SSO_RATE_LIMIT_USERINFO=60

# Branding and layout, normally set by an administrator under Settings → App
# settings. Setting one here pins it: the interface shows the value as fixed
# rather than offering to change it, so a deployment that manages its own
# configuration cannot have it edited away.
# SSO_BRAND_NAME="Acme Identity"
# SSO_BASE_COLOR=neutral
# SSO_ACCENT=default
# SSO_ROWS_PER_PAGE=15
# SSO_SIDEBAR_VARIANT=inset
# SSO_AUTH_LAYOUT=simple

# A public demonstration server. With this on, "sso:demo-reset" is allowed to
# drop the database and rebuild the sample data, and the scheduler runs it
# every SSO_DEMO_RESET_HOURS. Never turn this on for an installation holding
# anything you want to keep.
# SSO_DEMO_MODE=false
# SSO_DEMO_RESET_HOURS=6

# Audit trail retention, in days, set under Settings → App settings; uncomment
# to pin it here. The scheduled activitylog:clean command removes entries older
# than this. Set ACTIVITYLOG_ENABLED=false to stop recording entirely.
# SSO_AUDIT_RETENTION_DAYS=365

VITE_APP_NAME="${APP_NAME}"
